    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function copy(btn) {
            const text = btn.parentElement.innerText.replace("Copy", "").trim();

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text)
                    .then(() => {
                        btn.innerText = "Copied!";
                        setTimeout(() => btn.innerText = "Copy", 1000);
                    })
                    .catch(err => {
                        console.error("Clipboard error:", err);
                    });
            } else {
                // Fallback for HTTP/IP access
                const textarea = document.createElement("textarea");
                textarea.value = text;
                document.body.appendChild(textarea);

                textarea.select();

                try {
                    document.execCommand("copy");
                    btn.innerText = "Copied!";
                    setTimeout(() => btn.innerText = "Copy", 1000);
                } catch (err) {
                    console.error("Copy failed:", err);
                }

                document.body.removeChild(textarea);
            }
        }
    </script>
    <script>
        function logout() {
            // This sends a background request with a fake username 'logout'
            var xmlhttp = new XMLHttpRequest();
            xmlhttp.open("GET", "./", true, "logout", "wrong_password");
            xmlhttp.send("");

            xmlhttp.onreadystatechange = function () {
                if (xmlhttp.readyState == 4) {
                    // After the fake login fails, we refresh the page
                    window.location.reload();
                }
            }
        }
    </script> 
